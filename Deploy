# Place this file in the ROOT of your Git repo, next to the server/ and client/ folders:
#
#   your-repo/
#     render.yaml
#     server/   (package.json, app.js, config/db.js, controllers/, prisma/)
#     client/   (index.html, api.js, config.js)
#
# If your folders have different names, change `rootDir` and `staticPublishPath` below.

databases:
  - name: realestate-db
    plan: basic-256mb
    databaseName: realestate
    user: realestate

services:
  # ---------- API ----------
  - type: web
    name: realestate-api
    runtime: node
    plan: starter
    rootDir: server
    buildCommand: npm ci && npx prisma generate
    preDeployCommand: npx prisma migrate deploy # applies pending migrations before new code goes live
    startCommand: npm start
    healthCheckPath: /health
    envVars:
      - key: NODE_ENV
        value: production
      - key: DATABASE_URL
        fromDatabase:
          name: realestate-db
          property: connectionString
      - key: JWT_SECRET
        generateValue: true # Render creates a long random value once
      - key: CORS_ORIGIN
        sync: false # you'll be asked for this: the frontend's URL, no trailing slash

  # ---------- Frontend (plain HTML/JS, no build step) ----------
  - type: web
    name: realestate-web
    runtime: static
    buildCommand: echo "No build step"
    staticPublishPath: ./client
