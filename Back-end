model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      String     @default("USER")
  resources Resource[]
  createdAt DateTime   @default(now())
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
}
