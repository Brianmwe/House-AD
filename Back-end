const { z } = require('zod');
const prisma = require('../config/db'); // export a single shared PrismaClient from here

const PROPERTY_TYPES = ['HOUSE', 'APARTMENT', 'TOWNHOUSE', 'VILLA', 'LAND', 'COMMERCIAL'];

const httpError = (status, message) => Object.assign(new Error(message), { status });

// ---------- Validation ----------
const listQuery = z.object({
  page: z.coerce.number().int().min(1).default(1),
  limit: z.coerce.number().int().min(1).max(50).default(12), // hard cap protects the DB
  listingType: z.enum(['SALE', 'RENT']).optional(),
  propertyType: z.enum(PROPERTY_TYPES).optional(),
  city: z.string().trim().min(1).optional(),
  q: z.string().trim().min(2).optional(),
  minPrice: z.coerce.number().int().min(0).optional(),
  maxPrice: z.coerce.number().int().min(0).optional(),
  minBeds: z.coerce.number().int().min(0).optional(),
  minBaths: z.coerce.number().int().min(0).optional(),
  bbox: z.string().optional(), // "west,south,east,north" from the map viewport
  sort: z.enum(['newest', 'price_asc', 'price_desc']).default('newest'),
});

const propertyBody = z.object({
  title: z.string().trim().min(5).max(150),
  description: z.string().trim().min(20),
  listingType: z.enum(['SALE', 'RENT']),
  propertyType: z.enum(PROPERTY_TYPES),
  price: z.number().int().positive(),
  bedrooms: z.number().int().min(0).default(0),
  bathrooms: z.number().int().min(0).default(0),
  areaSqm: z.number().int().positive().optional(),
  features: z.array(z.string()).max(30).default([]),
  address: z.string().optional(),
  city: z.string().trim().min(1),
  neighborhood: z.string().optional(),
  latitude: z.number().min(-90).max(90).optional(),
  longitude: z.number().min(-180).max(180).optional(),
});

const ORDER_BY = {
  newest: { createdAt: 'desc' },
  price_asc: { price: 'asc' },
  price_desc: { price: 'desc' },
};

// Lightweight shape for result cards and map pins: no description, only the cover image
const LIST_SELECT = {
  id: true,
  title: true,
  price: true,
  currency: true,
  listingType: true,
  propertyType: true,
  bedrooms: true,
  bathrooms: true,
  areaSqm: true,
  city: true,
  neighborhood: true,
  latitude: true,
  longitude: true,
  images: { select: { url: true }, orderBy: { position: 'asc' }, take: 1 },
};

// ---------- Handlers ----------
exports.getAll = async (req, res, next) => {
  try {
    const f = listQuery.parse(req.query);

    const where = { status: 'ACTIVE' };
    if (f.listingType) where.listingType = f.listingType;
    if (f.propertyType) where.propertyType = f.propertyType;
    if (f.city) where.city = { equals: f.city, mode: 'insensitive' };
    if (f.minBeds !== undefined) where.bedrooms = { gte: f.minBeds };
    if (f.minBaths !== undefined) where.bathrooms = { gte: f.minBaths };
    if (f.minPrice !== undefined || f.maxPrice !== undefined) {
      where.price = { gte: f.minPrice, lte: f.maxPrice };
    }
    if (f.q) {
      // Fine for small tables; switch to Postgres full-text search or pg_trgm as data grows
      where.OR = [
        { title: { contains: f.q, mode: 'insensitive' } },
        { neighborhood: { contains: f.q, mode: 'insensitive' } },
        { city: { contains: f.q, mode: 'insensitive' } },
      ];
    }
    if (f.bbox) {
      const [west, south, east, north] = f.bbox.split(',').map(Number);
      if ([west, south, east, north].some(Number.isNaN)) throw httpError(400, 'Invalid bbox');
      where.latitude = { gte: south, lte: north };
      where.longitude = { gte: west, lte: east };
    }

    // One round trip: page of results and total count together
    const [data, total] = await prisma.$transaction([
      prisma.property.findMany({
        where,
        select: LIST_SELECT,
        orderBy: [ORDER_BY[f.sort], { id: 'asc' }], // id tiebreaker keeps pages stable
        skip: (f.page - 1) * f.limit,
        take: f.limit,
      }),
      prisma.property.count({ where }),
    ]);

    res.set('Cache-Control', 'public, max-age=30'); // short browser/CDN cache for anonymous browsing
    res.status(200).json({
      success: true,
      data,
      meta: { page: f.page, limit: f.limit, total, totalPages: Math.ceil(total / f.limit) },
    });
  } catch (error) {
    next(error);
  }
};

exports.getById = async (req, res, next) => {
  try {
    const property = await prisma.property.findFirst({
      where: { id: req.params.id, status: { in: ['ACTIVE', 'PENDING', 'SOLD', 'RENTED'] } },
      include: {
        images: { orderBy: { position: 'asc' } },
        owner: { select: { id: true, name: true, phone: true } }, // never expose email or password
      },
    });
    if (!property) throw httpError(404, 'Property not found');

    res.status(200).json({ success: true, data: property });
  } catch (error) {
    next(error);
  }
};

exports.create = async (req, res, next) => {
  try {
    const body = propertyBody.parse(req.body);
    const property = await prisma.property.create({
      data: { ...body, ownerId: req.user.id, status: 'ACTIVE' },
    });
    res.status(201).json({ success: true, data: property });
  } catch (error) {
    next(error);
  }
};

exports.update = async (req, res, next) => {
  try {
    const existing = await prisma.property.findUnique({
      where: { id: req.params.id },
      select: { ownerId: true },
    });
    if (!existing) throw httpError(404, 'Property not found');
    if (existing.ownerId !== req.user.id && req.user.role !== 'ADMIN') {
      throw httpError(403, 'You can only edit your own listings');
    }

    const body = propertyBody.partial().parse(req.body); // ownerId and status can't be changed here
    const property = await prisma.property.update({ where: { id: req.params.id }, data: body });
    res.status(200).json({ success: true, data: property });
  } catch (error) {
    next(error);
  }
};

// Soft delete: keeps history, favorites, and inquiries intact
exports.remove = async (req, res, next) => {
  try {
    const existing = await prisma.property.findUnique({
      where: { id: req.params.id },
      select: { ownerId: true },
    });
    if (!existing) throw httpError(404, 'Property not found');
    if (existing.ownerId !== req.user.id && req.user.role !== 'ADMIN') {
      throw httpError(403, 'You can only remove your own listings');
    }

    await prisma.property.update({ where: { id: req.params.id }, data: { status: 'ARCHIVED' } });
    res.status(200).json({ success: true, message: 'Listing archived' });
  } catch (error) {
    next(error);
  }
};
