    }

    function renderMapView() {
      // Render map pins and sidebar list corresponding to appState.filteredProperties
    }

    // --- Favorites Management ---
    function toggleFavorite(propertyId) {
      if (appState.favorites.has(propertyId)) {
        appState.favorites.delete(propertyId);
      } else {
        appState.favorites.add(propertyId);
      }
      document.getElementById('fav-count').textContent = appState.favorites.size;
      renderFavoritesDrawerContent();
    }

    function toggleFavoritesDrawer() {
      const drawer = document.getElementById('favorites-drawer');
      drawer.classList.toggle('hidden');
    }

    function renderFavoritesDrawerContent() {
      // Loop through appState.favorites and populate the side drawer
    }

    // --- Modal & Interactive Tool Handlers ---
    function openPropertyModal(propertyId) {
      appState.activeProperty = appState.properties.find(p => p.id === propertyId);
      // Populate modal DOM nodes with appState.activeProperty data
      document.getElementById('property-modal').classList.remove('hidden');
    }

    function closePropertyModal() {
      document.getElementById('property-modal').classList.add('hidden');
      appState.activeProperty = null;
    }

    function runCalculator() {
